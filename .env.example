# Supabase Configuration for TSquare Clothing Cafe (TCC)
# Obtain these from your Supabase Project Dashboard (Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Required for trusted server mutations. Keep strictly server-side.
SUPABASE_SECRET_KEY=your-secret-key-here

# Canonical site URL used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Explicit local-development demo mode. Never enable this in production.
NEXT_PUBLIC_TCC_DEMO_MODE=false
